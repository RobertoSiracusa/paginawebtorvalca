---
const navItems = [
  { name: "Inicio", href: "#" },
  { name: "Nosotros", href: "#nosotros" },
  { name: "Productos", href: "#productos" },
  { name: "Ubícanos", href: "#contacto" },
];
---

<header class="fixed w-full z-50 bg-white/90 backdrop-blur-md border-b border-gray-200 transition-all duration-300" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="#" class="flex items-center gap-3">
          <img class="h-12 w-auto object-contain" src="/images/logo_torvalca_2020-removebg-preview.png" alt="Torvalca Logo" />
          <span class="text-xl font-bold tracking-tight text-slate-900 hidden sm:block">TORVALCA</span>
        </a>
      </div>

      <!-- Desktop Menu -->
      <nav class="hidden md:flex space-x-8 items-center">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-slate-600 hover:text-torvalca-accent font-medium transition-colors text-sm uppercase tracking-wider"
          >
            {item.name}
          </a>
        ))}
        <a
          href="#contacto"
          class="bg-torvalca-yellow hover:bg-torvalca-gold text-slate-900 px-6 py-2.5 rounded-sm font-semibold uppercase tracking-wide text-xs transition-all transform hover:-translate-y-0.5 shadow-lg shadow-torvalca-yellow/20"
        >
          Contáctanos
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center">
        <button id="mobile-menu-btn" class="text-slate-600 hover:text-slate-900 p-2">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 absolute w-full">
    <div class="px-4 pt-2 pb-6 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block px-3 py-3 text-base font-medium text-slate-600 hover:text-torvalca-accent hover:bg-slate-50"
        >
          {item.name}
        </a>
      ))}
      <div class="pt-4">
        <a
          href="#contacto"
          class="block w-full text-center bg-torvalca-yellow text-slate-900 px-4 py-3 rounded-sm font-bold uppercase"
        >
          Contáctanos
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
